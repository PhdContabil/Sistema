# API Questor (somente-leitura) — usar SOMENTE no servidor (nunca no navegador)
QUESTOR_API_URL=https://phdfibra.dyndns.org
QUESTOR_API_KEY=coloque_sua_chave_aqui
# Chave de ESCRITA da API Questor (POST /cadastro/empresa) -- separada da
# QUESTOR_API_KEY de leitura, header X-Write-Key. Pega com quem administra
# o servidor Questor.
QUESTOR_WRITE_KEY=coloque_aqui_a_chave_de_escrita

# Questor Zen (módulo Edoc, escrita) — usado pelo Robô Zen (módulo Paralegal)
# para cadastrar contratos. Diferente da API acima: o token vai no PATH da
# URL, não em um header. QUESTOR_ZEN_TOKEN é a "Chave Acesso" (Minha Conta >
# Chave Acesso, dentro do Questor Zen) — NUNCA a senha de login.
QUESTOR_ZEN_DOMINIO=phd.app.questorpublico.com.br
QUESTOR_ZEN_TOKEN=coloque_aqui_sua_chave_de_acesso

# Supabase (para módulos futuros: auth, cadastros próprios)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
