# ---- Módulo Societário (migrado do societario-phd) ----

# API do Tareffa Societário
TAREFFA_API_BASE=https://societario.tareffa.com.br
TAREFFA_API_TOKEN=cole_aqui_o_token_do_perfil_em_societario.tareffa.com.br
TAREFFA_USE_API=false

# Supabase (mesmo projeto usado pelo societario-phd)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Protege os endpoints /api/*/cron/* contra chamadas externas. A varredura
# agendada do Robô Zen (/api/paralegal/robo-zen/cron/varredura) RECUSA tudo se
# isto não estiver definido.
CRON_SECRET=defina_um_valor_aleatorio

# Varredura agendada do Robô Zen: de quantas em quantas horas começar uma nova
# simulação sozinho (somente leitura). Vazio ou 0 = desligado (padrão). Também
# pode ficar na tabela app_config (chave ROBO_ZEN_VARREDURA_HORAS), o que liga e
# desliga sem redeploy. Precisa de um agendador EXTERNO chamando a rota da
# varredura (o plano Hobby da Vercel nao aceita cron de minuto em minuto).
# ROBO_ZEN_VARREDURA_HORAS=24
